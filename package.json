{
  "name": "maphound",
  "version": "0.5.0",
  "private": true,
  "description": "Passive source map and bundle secret scanner. Everything stays local.",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm rules:compile && wxt",
    "build": "pnpm rules:compile && wxt build",
    "zip": "pnpm rules:compile && wxt zip",
    "typecheck": "pnpm rules:compile && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm rules:compile && vitest run",
    "test:e2e": "playwright test",
    "rules:compile": "tsx scripts/compile-rules.ts",
    "rules:check": "tsx scripts/check-rules.ts",
    "preview:images": "tsx scripts/generate-preview.ts",
    "postinstall": "wxt prepare && tsx scripts/compile-rules.ts"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@preact/signals": "^2.11.4",
    "@webext-core/messaging": "^4.0.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "preact": "^11.2.0",
    "tldts": "^7.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.8",
    "recheck": "^4.6.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5",
    "yaml": "^2.9.1"
  }
}
